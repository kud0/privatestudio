<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.85s ease-out forwards;
  }
</style>

<script>
  // Rotating headlines — desktop
  const headlines = document.querySelectorAll('.hero-headline');
  let current = 0;
  setInterval(() => {
    (headlines[current] as HTMLElement).style.opacity = '0';
    current = (current + 1) % headlines.length;
    (headlines[current] as HTMLElement).style.opacity = '1';
  }, 7000);

  // Rotating headlines — mobile
  const headlinesM = document.querySelectorAll('.hero-headline-m');
  let currentM = 0;
  setInterval(() => {
    (headlinesM[currentM] as HTMLElement).style.opacity = '0';
    currentM = (currentM + 1) % headlinesM.length;
    (headlinesM[currentM] as HTMLElement).style.opacity = '1';
  }, 7000);

  // Desktop mute
  const btn = document.getElementById('mute-btn');
  const desktop = document.getElementById('reel-desktop') as HTMLVideoElement | null;
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');
  btn?.addEventListener('click', () => {
    if (!desktop) return;
    desktop.muted = !desktop.muted;
    iconMuted?.classList.toggle('hidden', !desktop.muted);
    iconUnmuted?.classList.toggle('hidden', desktop.muted);
  });

  // Mobile mute
  const btnM = document.getElementById('mute-btn-mobile');
  const mobile = document.getElementById('reel-mobile') as HTMLVideoElement | null;
  const iconMutedM = document.getElementById('icon-muted-m');
  const iconUnmutedM = document.getElementById('icon-unmuted-m');
  btnM?.addEventListener('click', () => {
    if (!mobile) return;
    mobile.muted = !mobile.muted;
    iconMutedM?.classList.toggle('hidden', !mobile.muted);
    iconUnmutedM?.classList.toggle('hidden', mobile.muted);
  });
</script>
