---
const products = [
  { id: 'dark-wax', name: 'Dark Wax', first: 'Dark', last: 'Wax', number: '01', category: 'El acabado', description: 'Define tu peinado y matiza las canas con una cera negra de intensidad regulable. Ajusta la cantidad para un tono más uniforme y un acabado natural, a la medida de tu estilo.', ritual: 'Tu tono. Tu acabado.', type: 'Cera negra' },
  { id: 'sea-salt', name: 'Sea Salt', first: 'Sea', last: 'Salt', number: '02', category: 'La textura', description: 'Cuerpo, textura y movimiento con acabado mate. Un spray de sales marinas que ayuda a definir las ondas y dar volumen, especialmente en cabellos finos, sin perder naturalidad.', ritual: 'Encuentra tu movimiento.', type: 'Spray de sal' },
  { id: 'beard-oil', name: 'Beard Oil', first: 'Beard', last: 'Oil', number: '03', category: 'El cuidado', description: 'Suavidad, orden y un brillo cuidado para tu barba. Una mezcla de aceites de argán, nuez y maíz que acondiciona el vello en tu rutina diaria. Unas gotas, sin aclarado.', ritual: 'Un ritual de cada día.', type: 'Aceite de barba' },
];
---

<section id="products" class="ps-products" aria-labelledby="ps-products-title">
  <span id="brands" class="ps-anchor" aria-hidden="true"></span>
  <span class="ps-viewport-probe" aria-hidden="true"></span>
  <div class="ps-stage">
    <div class="ps-topline">
      <div class="ps-signature">PRIVATE STUDIO<span>GROOMING ESSENTIALS</span></div>
      <a class="ps-skip" href="#services"><span data-i18n="collection.skip">Continuar</span><span aria-hidden="true">↓</span></a>
    </div>
    <div class="ps-intro">
      <p class="ps-eyebrow" data-i18n="collection.eyebrow">Nuestra propia esencia</p>
      <h2 id="ps-products-title"><span data-i18n="collection.title1">El cuidado de<br/>Private Studio,</span><br/><em data-i18n="collection.title2">también en casa.</em></h2>
      <p class="ps-intro-note" data-i18n="collection.intro">Tres esenciales.<br/>El sello de Private Studio.</p>
    </div>
    <div class="ps-backdrop" aria-hidden="true"></div>
    <div class="ps-canvas" aria-hidden="true"></div>
    <div class="ps-orbit" aria-hidden="true"></div>
    <div class="ps-presentation">
      <div class="ps-visual-space" aria-hidden="true">
        <div class="ps-collection-label"><span data-i18n="collection.three">Tres esenciales.</span><br/><i data-i18n="collection.signature">Private Studio.</i></div>
        <div class="ps-model-space"></div>
      </div>
      <div class="ps-details">
      {products.map((product, index) => (
        <article class="ps-product" data-product={index} id={`product-${product.id}`}>
          <img class="ps-fallback-image" src={`/images/private-studio/${product.id}.png`} alt={`${product.name} Private Studio, 100 ml`} width="768" height="768" loading="lazy" />
          <div class="ps-product-copy">
            <div class="ps-product-index"><span>{product.number} <span class="ps-muted">/ 03</span></span><span class="ps-index-line"></span><span data-i18n={`collection.${product.id}.category`}>{product.category}</span></div>
            <h3><span>{product.first}</span> <em>{product.last}</em><span class="ps-title-dot">.</span></h3>
            <p class="ps-type"><span data-i18n={`collection.${product.id}.type`}>{product.type}</span><span>100 ml</span></p>
            <p class="ps-description" data-i18n={`collection.${product.id}.description`}>{product.description}</p>
            <p class="ps-ritual" data-i18n={`collection.${product.id}.ritual`}>{product.ritual}</p>
            <a class="ps-discover" href="#services"><span data-i18n="collection.discover">Descúbrelo en el studio</span><span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
      </div>
    </div>
    <div class="ps-bottomline">
      <span class="ps-scroll-note"><span class="ps-scroll-icon" aria-hidden="true">↓</span><span data-i18n="collection.scroll">Scroll para descubrir</span></span>
      <nav class="ps-product-nav" aria-label="Grooming essentials">
        {products.map((product, index) => (<button type="button" data-product-target={index} aria-label={product.name}><span class="ps-nav-number">{product.number}</span><span>{product.name}</span><span class="ps-nav-track"><span></span></span></button>))}
      </nav>
      <span class="ps-edition">MEN CARE <span>—</span> BARCELONA</span>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.ps-products');
  if (section) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const viewportProbe = section.querySelector<HTMLElement>('.ps-viewport-probe')!;
    // The browser's address bar must not switch presentations mid-gesture.
    const sizeMatches = () => viewportProbe.clientHeight >= (innerWidth < 768 ? 640 : 700);
    let eligibleSize = sizeMatches();
    let cleanup: (() => void) | undefined;
    let loading = false;
    const start = async () => {
      if (motion.matches || !sizeMatches() || loading || cleanup) return;
      loading = true;
      try {
        const { mountProductScene } = await import('../scripts/products-scene');
        if (!motion.matches && sizeMatches()) cleanup = await mountProductScene(section);
      } catch (error) {
        console.warn('Product collection: using the photographic presentation.', error);
      } finally { loading = false; }
    };
    const observer = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) void start();
    }, { rootMargin: '650px' });
    observer.observe(section);
    // Hash navigation can restore a scroll position before the lazy scene mounts.
    if (/^#(?:products|brands|product-)/.test(location.hash)) void start();
    const preferenceChanged = () => {
      if (motion.matches || !sizeMatches()) { cleanup?.(); cleanup = undefined; }
      else void start();
    };
    const sizeChanged = () => {
      const eligible = sizeMatches();
      if (eligible === eligibleSize) return;
      eligibleSize = eligible;
      preferenceChanged();
    };
    motion.addEventListener('change', preferenceChanged);
    window.addEventListener('resize', sizeChanged, { passive: true });
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect(); cleanup?.();
      motion.removeEventListener('change', preferenceChanged);
      window.removeEventListener('resize', sizeChanged);
    }, { once: true });
  }
</script>

<style>
  .ps-products { --ps-paper: #000; --ps-ink: #fff; --ps-beige: #e0d4ba; position: relative; background: var(--ps-paper); color: var(--ps-ink); scroll-margin-top: 80px; }
  .ps-anchor { position: absolute; top: 0; }
  .ps-viewport-probe { position: absolute; width: 0; height: 100svh; visibility: hidden; pointer-events: none; }
  .ps-stage { position: relative; overflow: hidden; padding: 56px 5vw; isolation: isolate; }
  .ps-topline { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 3; }
  .ps-signature { font-size: 14px; font-weight: 700; letter-spacing: .22em; }
  .ps-signature span { display: block; font-size: 8px; letter-spacing: .28em; margin-top: 5px; font-weight: 500; }
  .ps-skip { display: flex; gap: 20px; align-items: center; text-transform: uppercase; font-size: 9px; letter-spacing: .17em; padding: 12px 0 12px 12px; }
  .ps-skip > span:last-child { font-size: 20px; }
  .ps-intro { position: relative; z-index: 2; margin-top: 68px; pointer-events: none; }
  .ps-eyebrow { color: var(--ps-beige); font-weight: 700; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; margin-bottom: 25px; }
  .ps-intro h2 { font-size: clamp(36px, 5.2vw, 80px); line-height: .98; letter-spacing: -.055em; font-weight: 900; text-transform: uppercase; }
  .ps-intro h2 em { font-family: inherit; font-weight: 900; font-style: normal; color: var(--ps-beige); }
  .ps-intro-note { margin-top: 26px; font-size: 13px; line-height: 1.7; color: #9ca3af; }
  .ps-backdrop, .ps-canvas, .ps-orbit, .ps-collection-label, .ps-bottomline { display: none; }
  .ps-product { display: grid; grid-template-columns: 1.25fr 1fr; gap: 8%; align-items: center; margin: 80px 0; scroll-margin-top: 110px; min-width: 0; }
  .ps-fallback-image { width: 100%;  }
  .ps-product-index { display: flex; gap: 16px; align-items: center; font-size: 10px; text-transform: uppercase; letter-spacing: .15em; }
  .ps-muted { color: #6b7280; margin-left: 6px; }
  .ps-index-line { display: block; width: 45px; height: 1px; background: #e0d4ba40; }
  .ps-product h3 { font-size: clamp(48px, 5.3vw, 80px); line-height: .93; font-weight: 900; letter-spacing: -.05em; text-transform: uppercase; margin: 27px 0 24px; }
  .ps-product h3 em { font-family: inherit; font-style: normal; font-weight: 900; color: var(--ps-beige); }
  .ps-title-dot { display: none; }
  .ps-type { display: flex; gap: 25px; text-transform: uppercase; font-size: 9px; letter-spacing: .18em; margin-bottom: 24px; }
  .ps-type > span + span { border-left: 1px solid #e0d4ba40; padding-left: 25px; }
  .ps-description { max-width: 330px; font-size: 14px; line-height: 1.9; color: #9ca3af; font-weight: 300; }
  .ps-ritual { font-family: inherit; font-weight: 600; font-size: 15px; margin-top: 19px; color: var(--ps-beige); }
  .ps-discover { display: inline-flex; align-items: center; gap: 35px; margin-top: 35px; padding: 16px 24px; background: #fdfbf7; color: #000; font-weight: 900; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .ps-discover > span:last-child { font-size: 19px; transition: transform .2s; }
  .ps-discover:hover > span:last-child { transform: translate(3px, -3px); }
  a:focus-visible, button:focus-visible { outline: 2px solid #e0d4ba; outline-offset: 6px; }
  .ps-products[data-enhanced] { height: 660svh; scroll-margin-top: 0; }
  [data-enhanced] .ps-stage { position: sticky; top: 0; height: 100svh; padding: 110px 5vw 38px; display: flex; flex-direction: column; }
  [data-enhanced] .ps-intro { position: absolute; left: 7%; top: 28%; width: 46%; margin: 0; will-change: transform, opacity; }
  [data-enhanced] .ps-intro h2 { font-size: clamp(36px, min(4.1vw, 7svh), 72px); }
  [data-enhanced] .ps-intro-note { margin-top: 26px; }
  [data-enhanced] .ps-backdrop { display: block; position: absolute; inset: 0; background: radial-gradient(ellipse at 28% 55%, #5c52402e 0%, transparent 56%); z-index: -1; pointer-events: none; }
  [data-enhanced] .ps-canvas { display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .ps-canvas :global(canvas) { width: 100%; height: 100%; display: block; }
  [data-enhanced] .ps-orbit { display: block; position: absolute; border: 1px solid #e0d4ba26; border-radius: 50%; opacity: 0; pointer-events: none; }
  [data-enhanced] .ps-presentation { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 6%; min-height: 0; flex: 1; margin: clamp(24px, 4svh, 60px) 1% 78px 0; }
  [data-enhanced] .ps-visual-space { position: relative; min-height: 0; }
  [data-enhanced] .ps-model-space { position: absolute; inset: 62px 0 0; }
  [data-enhanced] .ps-collection-label { display: block; font-size: 18px; font-weight: 900; text-transform: uppercase; line-height: 1.15; letter-spacing: -.035em; opacity: 0; }
  .ps-collection-label i { font-family: inherit; font-size: inherit; font-style: normal; color: var(--ps-beige); }
  [data-enhanced] .ps-details { display: grid; align-items: center; min-width: 0; pointer-events: none; z-index: 2; }
  [data-enhanced] .ps-product { display: block; grid-area: 1 / 1; margin: 0; opacity: 0; will-change: opacity, transform; pointer-events: none; }
  [data-enhanced] .ps-product[data-active] { pointer-events: auto; }
  [data-enhanced] .ps-fallback-image { display: none; }
  [data-enhanced] .ps-product h3 > span:first-child { display: block; }
  [data-enhanced] .ps-product h3 { font-size: clamp(44px, min(5.3vw, 8svh), 80px); margin: 20px 0 18px; }
  [data-enhanced] .ps-type { margin-bottom: 18px; }
  [data-enhanced] .ps-description { line-height: 1.75; }
  [data-enhanced] .ps-ritual { margin-top: 16px; }
  [data-enhanced] .ps-discover { margin-top: 24px; gap: 22px; }
  [data-enhanced] .ps-bottomline { display: flex; position: absolute; left: 5%; right: 5%; bottom: 36px; z-index: 3; align-items: end; justify-content: space-between; }
  .ps-scroll-note, .ps-edition { font-size: 8px; letter-spacing: .17em; text-transform: uppercase; }
  .ps-scroll-note { display: flex; align-items: center; gap: 15px; }
  .ps-scroll-icon { height: 35px; width: 22px; border: 1px solid #e0d4ba40; border-radius: 16px; display: grid; place-items: center; font-size: 14px; }
  .ps-edition { color: #9ca3af; }
  .ps-edition span { margin: 0 12px; }
  .ps-product-nav { display: flex; gap: 30px; }
  .ps-product-nav button { min-height: 44px; position: relative; display: flex; align-items: center; gap: 10px; padding: 0 0 15px; font-size: 9px; letter-spacing: .08em; color: #9ca3af; text-transform: uppercase; font-weight: 700; }
  .ps-product-nav button[aria-current="true"] { color: #e0d4ba; }
  .ps-nav-number { font-size: 8px; opacity: .65; }
  .ps-nav-track { position: absolute; height: 1px; background: #ffffff26; bottom: 0; left: 0; right: 0; }
  .ps-nav-track > span { display: block; width: 100%; height: 1px; background: #e0d4ba; transform: scaleX(0); transform-origin: left; }
  @media (max-width: 1023px) {
    .ps-products[data-enhanced] { height: 450svh; }
    [data-enhanced] .ps-stage { padding: 98px 7% 80px; }
    [data-enhanced] .ps-intro { left: 7%; top: 170px; width: 86%; }
    [data-enhanced] .ps-intro h2 { font-size: clamp(32px, min(8.5vw, 6svh), 56px); }
    [data-enhanced] .ps-intro-note { font-size: 11px; margin-top: 16px; }
    [data-enhanced] .ps-presentation { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; gap: 18px; margin: 16px 0 64px; }
    [data-enhanced] .ps-model-space { inset: 0; }
    [data-enhanced] .ps-collection-label { display: none; }
    [data-enhanced] .ps-backdrop { background: radial-gradient(ellipse at 50% 30%, #5c52402e 0%, transparent 55%); }
    [data-enhanced] .ps-details { align-items: start; }
    [data-enhanced] .ps-product-copy { padding: 0; }
    [data-enhanced] .ps-product-index { font-size: 9px; gap: 12px; }
    [data-enhanced] .ps-product h3 { font-size: clamp(38px, 5vw, 48px); margin: 12px 0; }
    [data-enhanced] .ps-product h3 > span:first-child { display: inline; }
    [data-enhanced] .ps-type { font-size: 9px; margin-bottom: 12px; }
    [data-enhanced] .ps-description { font-size: 12px; line-height: 1.7; max-width: 540px; }
    [data-enhanced] .ps-ritual { display: none; }
    [data-enhanced] .ps-discover { font-size: 9px; padding: 12px 18px; margin-top: 14px; gap: 22px; }
    [data-enhanced] .ps-bottomline { bottom: 80px; left: 7%; right: 7%; }
    .ps-scroll-note, .ps-edition { display: none; }
    .ps-product-nav { width: 100%; justify-content: space-between; gap: 18px; }
    .ps-product-nav button { flex: 1; font-size: 9px; gap: 7px; padding-bottom: 8px; }
  }
  @media (max-width: 767px) {
    .ps-stage { padding: 42px 24px 55px; }
    .ps-signature { font-size: 11px; }
    .ps-signature span { font-size: 7px; }
    .ps-intro { margin-top: 55px; }
    .ps-product { grid-template-columns: 1fr; gap: 20px; margin: 50px 0 80px; }
    .ps-product-copy { padding: 0 6px; }
    .ps-product h3 { font-size: 56px; }
    .ps-description { max-width: 420px; }
    [data-enhanced] .ps-product-index { font-size: 8px; gap: 12px; }
    [data-enhanced] .ps-product h3 { font-size: 42px; margin: 12px 0 12px; }
    [data-enhanced] .ps-type { font-size: 8px; margin-bottom: 12px; }
    [data-enhanced] .ps-description { font-size: 11px; line-height: 1.7; max-width: 360px; }
    .ps-product-nav button { font-size: 8px; }
  }
  @media (max-width: 767px) and (max-height: 740px) {
    [data-enhanced] .ps-stage { padding-top: 87px; }
    [data-enhanced] .ps-intro { top: 147px; }
    [data-enhanced] .ps-eyebrow { margin-bottom: 16px; }
    [data-enhanced] .ps-presentation { gap: 12px; }
    [data-enhanced] .ps-product h3 { font-size: 38px; margin: 9px 0; }
    [data-enhanced] .ps-description { font-size: 10px; }
    [data-enhanced] .ps-type { margin-bottom: 8px; }
    [data-enhanced] .ps-discover { margin-top: 9px; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .ps-edition { display: none; }
  }
</style>
